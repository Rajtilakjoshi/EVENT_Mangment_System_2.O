# =================================================================
# Divine Energy Hub — Environment Configuration (2026 Edition)
# =================================================================

# -----------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (React 18 / CRA) -> Copy to .env.local
# -----------------------------------------------------------------
PORT=3000
REACT_APP_API_URL=http://localhost:8080
REACT_APP_ENVIRONMENT=development

# AWS S3 Storage (for direct photo uploads / viewing)
REACT_APP_AWS_REGION=us-east-1
REACT_APP_AWS_S3_BUCKET_NAME=divine-event-photos-2026

# (Legacy / Migration) Firebase Configuration (Optional if using AWS S3)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------
# 2. BACKEND ENVIRONMENT (Python 3.12 Flask / FastAPI) -> backend/.env
# -----------------------------------------------------------------
PORT=8080
FLASK_ENV=development
API_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key

# Database (MongoDB Atlas / AWS DocumentDB)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=divine_dashboard_2026

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,https://event.divineenergyhub.org

# -----------------------------------------------------------------
# 3. AWS CLOUD SERVICES (2026 Infrastructure)
# -----------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use IAM Role when hosted on AWS EC2 / App Runner / ECS
AWS_S3_PHOTO_BUCKET=divine-event-photos-2026

# AWS SES (Simple Email Service for Staff Login & Reset Codes)
AWS_SES_SENDER_EMAIL=noreply@divineenergyhub.org
AWS_SES_REGION=us-east-1

# (Optional / Legacy) SMTP Email Configuration
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@divineenergyhub.org
DEV_EMAIL=dev@divineenergyhub.org

# Google Sheets Sync (Mirroring)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Guests_2026
GOOGLE_SERVICE_ACCOUNT_FILE=./serviceAccountKey.json

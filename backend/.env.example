# =================================================================
# Backend Environment Configuration Template (Flask 3 / Python 3.12)
# Copy this file to `backend/.env` for local execution or set in cloud environment
# =================================================================

PORT=5000
FLASK_ENV=production
API_SECRET_KEY=your_strong_jwt_or_session_secret

# Set API_KEY if you want protected endpoints (leave empty for unauthenticated dev mode)
API_KEY=

# MongoDB Connection String (Atlas M0 Free Tier or self-hosted)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/divine_dashboard_2026?retryWrites=true&w=majority
MONGO_DB=divine_dashboard_2026

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app

# AWS Cloud Services Configuration (S3 for high-res photo uploads)
AWS_REGION=us-east-1
AWS_S3_PHOTO_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_SENDER_EMAIL=noreply@yourdomain.org

# Google Sheets Live Sync Configuration
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEET_NAME=All Guests
GOOGLE_SERVICE_ACCOUNT_FILE=serviceAccountKey.json
